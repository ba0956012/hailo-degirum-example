# --- 活體偵測 AntiSpoof 模型設定 ---
MODEL_PATH=anti_spoof_models/AntiSpoofing_bin_1.5_128.onnx
THRESHOLD=0.5               # 判定真人臉的機率閾值，通常設定0.5以上

# --- 臉部辨識設定 ---
RECOGNITION_SCORE=0.7        # 辨識分數閾值，大於這個分數才算成功辨識
ANTISPOOFING_SCORE=0.0       # 活體檢測分數閾值

# --- 臉部辨識模型設定 ---
FACE_DET_MODEL_NAME=scrfd
FACE_REC_MODEL_NAME=arcface_mobilefacenet--112x112_quant_hailort_hailo8l_1
INFERENCE_HOST_ADDRESS=@local    # 模型推論伺服器，例如 @local 或 @cloud

# --- 模型Zoo設定（模型json描述檔路徑）---
FACE_DET_ZOO_URL=./model/scrfd_10g/scrfd.json
FACE_REC_ZOO_URL=./model/arcface_mobilefacenet--112x112_quant_hailort_hailo8l_1/arcface_mobilefacenet--112x112_quant_hailort_hailo8l_1.json

# --- 人臉資料庫設定(LanceDB) ---
FACE_DB_URI=./face_database      
TABLE_NAME=face                

SQL_URI=./attendance.db
attendance_time_inrerval=10
